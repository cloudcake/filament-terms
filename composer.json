{
  "name": "cloudcake/filament-terms",
  "type": "library",
  "license": "proprietary",
  "description": "Filament panel terminology per tenant and/or per panel.",
  "require": {
    "php": "^8.2",
    "cloudcake/filament-icons": "dev-main",
    "filament/filament": "^4.0|^5.0"
  },
  "autoload": {
    "psr-4": {
      "Cloudcake\\Terms\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Cloudcake\\Terms\\ServiceProvider"
      ]
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.cloudcake.dev"
    }
  ]
}
